<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.lc4jlens</groupId>
  <artifactId>lc4j-lens</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>lc4j-lens</name>
  <description>Local embedding-space debugger for LangChain4j EmbeddingStore. t-SNE-projects stored embeddings to a 2D scatter plot (with k-means topic clusters and cross-model query comparison), served over a built-in HTTP server, so you can see why a query pulled in the chunks it did.</description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <langchain4j.version>1.18.1</langchain4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-core</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>

    <!--
      t-SNE, not PCA: PCA projects along directions of max variance, which
      does not correlate with which chunks are actually near each other by
      cosine similarity. t-SNE is built specifically to preserve local
      neighbor structure, which is the whole point of this tool (showing
      why a query's real nearest neighbors ended up where they did).
    -->
    <dependency>
      <groupId>de.javagl</groupId>
      <artifactId>bh-tsne</artifactId>
      <version>0.0.1</version>
    </dependency>

    <!--
      Provides InMemoryEmbeddingStore, which LensLauncher checks for via instanceof
      to request an exact full listing (via its public size()) instead of the generic
      maxPoints-capped approximation used for other store types.
    -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>

    <!-- Demo/self-check only: local, no-API-key embedding models -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-embeddings-all-minilm-l6-v2-q</artifactId>
      <version>1.18.0-beta28</version>
      <scope>test</scope>
    </dependency>
    <!-- A second, differently-trained local model with the SAME output dimensionality
         (384) as the one above, used to demo what happens when the store was built
         with one embedding model and a query comes in through another. -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-embeddings-bge-small-en-v15-q</artifactId>
      <version>1.18.0-beta28</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -q test-compile exec:java -Pdemo -->
    <profile>
      <id>demo</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.2.0</version>
            <configuration>
              <mainClass>io.lc4jlens.Demo</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
